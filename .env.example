# QuantPy - copy to .env and fill in. NEVER commit .env.

# AI (advisory only)
ANTHROPIC_API_KEY=
# QUANTPY_MODEL=claude-sonnet-4-6

# Alpaca - paper trading by default
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Web login (2FA via setup_2fa.py is mandatory)
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
QUANT_USER=
# Use a bcrypt hash (recommended):
#   python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
QUANT_PASSWORD_HASH=
# ...or a plain password (less secure):
# QUANT_PASSWORD=

# Server
# QUANTPY_HOST=127.0.0.1
# QUANTPY_HTTPS=0

# Optional risk overrides (defaults in quantpy/risk/limits.py), e.g.:
# RISK_MAX_POSITION_PCT=0.05
# RISK_MAX_DAILY_LOSS_PCT=0.02

# Live trading needs ALL THREE (see docs/LEGAL_DE.md). Leave unset for paper trading.
# RISK_ALLOW_LIVE_TRADING=true
# QUANTPY_LIVE_CONFIRM=YES_USE_REAL_MONEY
# LEGAL_ACK=<phrase from quantpy/risk/compliance.py>
